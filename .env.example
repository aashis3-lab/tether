# Supabase project settings, Project Settings -> API in the Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# MapTiler API key for map tiles (free tier is fine), https://cloud.maptiler.com/account/keys/
# Without it, maps show a "Map unavailable" message instead of tiles.
VITE_MAPTILER_KEY=

# Public address friends open for invite links + QR codes (no trailing slash), e.g.
# https://tether.vercel.app or the "Network: https://…" address from `npm run dev:phone`.
# Leave empty to use whatever address the creator's browser is on.
VITE_PUBLIC_APP_URL=

# SafeRide dispatch number for the Get home screen (defaults to 217-384-8188).
VITE_SAFERIDE_PHONE=+12173848188

# Twilio SMS for guardian alerts / emergencies (Phase 7, optional).
# Leave false during the hackathon unless Twilio is wired up, alerts will log + show in the
# guardian view instead of sending a real text.
VITE_TWILIO_ENABLED=false
