# Supabase project settings, Project Settings -> API in the Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# MapTiler API key for map tiles (free tier is fine), https://cloud.maptiler.com/account/keys/
# Without it, maps show a "Map unavailable" message instead of tiles.
VITE_MAPTILER_KEY=

# Google Maps Platform key for venue search, nearby suggestions and address lookups.
# Enable "Places API (New)" and "Geocoding API", and restrict the key by HTTP referrer
# (localhost + your Vercel domain). Without it, Tether falls back to MapTiler + OpenStreetMap.
VITE_GOOGLE_MAPS_KEY=

# Public address friends open for invite links + QR codes (no trailing slash), e.g.
# https://tether-demo.vercel.app or the "Network: https://…" address from `npm run dev:phone`.
# Leave empty to use whatever address the creator's browser is on.
VITE_PUBLIC_APP_URL=

# HELP screen "Call 911" safety switch (DEMO_SAFE_911). Anything but "false" = ON:
# the 911 button dials VITE_DEMO_911_NUMBER (e.g. a teammate's phone) and shows "Demo mode".
# Set VITE_DEMO_SAFE_911=false only when you really want it to dial 911.
VITE_DEMO_SAFE_911=true
VITE_DEMO_911_NUMBER=

# SafeRide dispatch number for the Get home screen (defaults to 217-384-8188).
VITE_SAFERIDE_PHONE=+12173848188

# Sign-in mode. "sms" (default) = real text codes via Supabase phone auth (configure Twilio under
# Authentication -> Providers -> Phone). "mock" = code shown on screen, local development only.
VITE_AUTH_MODE=sms

# Demo speed multiplier for automatic escalation timers.
# 1 = real-world minutes. 60 = every "minute" in the rules becomes 1 second (good for a pitch demo).
VITE_DEMO_SPEED=1

# Twilio SMS for guardian alerts / emergencies (Phase 7, optional).
# Leave false during the hackathon unless Twilio is wired up, alerts will log + show in the
# guardian view instead of sending a real text.
VITE_TWILIO_ENABLED=false
