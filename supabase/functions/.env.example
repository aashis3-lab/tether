# Secrets for Supabase Edge Functions.
# Set them in Dashboard -> Edge Functions -> Secrets, or with
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit a filled-in copy. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are provided to functions automatically, don't set them yourself.

# Base URL used to build /guardian/:token links in guardian texts.
APP_BASE_URL=http://localhost:5173

# Shared secret pg_cron sends in the x-cron-secret header. Copy it from Vault:
#   select decrypted_secret from vault.decrypted_secrets where name = 'tether_cron_secret';
CRON_SECRET=

# Web push (VAPID). Same public key as the app's VITE_VAPID_PUBLIC_KEY.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
